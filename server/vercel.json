{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/v1/models", "destination": "/api/models" },
    { "source": "/v1/chat/completions", "destination": "/api/chat_completions" },
    { "source": "/healthz", "destination": "/api/healthz" }
  ]
}